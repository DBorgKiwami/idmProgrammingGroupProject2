<%- include("../partials/header.ejs") %>
<body>
<%- include("../partials/navigation.ejs") %>
<% if (Array.isArray(popularPosts) && popularPosts.length > 0) { %>
  <% for (var i = 0; i < popularPosts.length; i++) { %>
    <div class="post">
      <h1 class="posttitle">
          <%=popularPosts[i].post_title%>
      </h1>
      <div class="post_body">
          <%=popularPosts[i].post_body%>
          <% if (popularPosts[i].image_path) { %>
            <div class="postimagediv">
              <img src="assets/uploads/<%=popularPosts[i].image_path%>" width="250" height="250" style="border-radius: 10%;">
            </div>
          <% } %>
          <div class="postinfo">
            <div class="postgame"><%=popularPosts[i].game_name%></div>
            <div class="postusername"><a href="/user/<%=popularPosts[i].user_id%>"><%=popularPosts[i].username%></a></div>
            <div class="postlikes" data-postid="<%=popularPosts[i].post_id%>"><%=popularPosts[i].like_count%></div>
          </div>
      </div>
          <% if (user) { %>
          <div class="commentform">
            <form action="/comment/<%=popularPosts[i].post_id%>" method="post" enctype="multipart/form-data" class="upload-form">
              <input id="content" name="content" type="text">
              <button type="submit">Comment</button>
            </form>
            <button class="likebutton" id="likebutton" data-postid="<%=popularPosts[i].post_id%>">Like Button</button>
          </div>
          <% } %>
          <button class="commentbutton" id="commentbutton" data-postid="<%=popularPosts[i].post_id%>">View Comments</button>
          <div class="commentsection">
          </div>
    </div>
  <% } %>
<% } else { %>
  <p>No posts found yet.</p>
<% } %>
</body>
<script src="/viewcomments.js"></script>
<script src="/likebutton.js"></script>
<%- include("../partials/footer.ejs") %>