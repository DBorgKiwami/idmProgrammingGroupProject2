<!DOCTYPE html>
<html lang="en">
<head>
    <title>
        Homepage
    </title>
</head>
<body>
<%- include("../partials/navigation.ejs") %>
<% if (Array.isArray(popularPosts) && popularPosts.length > 0) { %>
  <% for (var i = 0; i < popularPosts.length; i++) { %>
    <h1>
        <%=popularPosts[i].post_title%>
    </h1>
    <p>
        <%=popularPosts[i].post_body%>
        <%=popularPosts[i].game_name%>
        <%=popularPosts[i].username%>
    </p>
  <% } %>
<% } else { %>
  <p>No posts found yet.</p>
<% } %>
</body>