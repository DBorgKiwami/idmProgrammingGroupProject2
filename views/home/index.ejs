<%- include("../partials/header.ejs") %>
<body>
<div class="app-layout">

    <%- include("../partials/navigation.ejs") %>

    <main class="main-content">

        <div class="hero-section">
            <div class="hero-overlay"></div>
            <div class="hero-content">
                <p class="hero-label">Featured</p>
                <h1 class="hero-title">Welcome to GameHub</h1>
                <p class="hero-desc">Discover games, share your thoughts, and connect with fellow gamers.</p>
                <% if (user) { %>
                    <a href="/post" class="hero-btn">+ Create Post</a>
                <% } else { %>
                    <a href="/register" class="hero-btn">Join Now</a>
                <% } %>
            </div>
        </div>

        <% if (user && user.fav_genres) { %>
            <div class="feed-section" style="border-radius: 15px; margin-bottom: 20px;">
                <div class="section-header">
                    <h2 class="section-title">
                        Recommended: <%= genreInfo ? genreInfo.genre_name : "Post For You" %>
                    </h2>
                    <span class="section-sub">
                        <%= genreInfo ? genreInfo.genre_description : "Based on your favorite genre" %>
                    </span>
                </div>

                <div class="posts-grid">
                    <% if (genrePosts && genrePosts.length > 0) { %>
                        <% genrePosts.forEach(function(post) { %>
                            <div class="post-card">
                                <div class="post-card-image">
                                    <% if (post.image_path) { %>
                                        <img src="assets/uploads/<%=post.image_path%>" alt="<%=post.post_title%>">
                                    <% } else { %>
                                        <div class="post-card-image--placeholder"><i class="fas fa-gamepad"></i></div>
                                    <% } %>
                                </div>
                                <div class="post-card-info">
                                    <span class="post-card-game"><%=post.game_name%></span>
                                    <h3 class="post-card-title"><%=post.post_title%></h3>
                                    <p class="post-card-body"><%=post.post_body%></p>
                                    <div class="post-card-meta">
                                        <span class="post-card-user"><i class="fas fa-circle-user"></i> <%=post.username%></span>
                                        <span class="post-card-likes"><i class="fas fa-heart"></i><span class="postlikes" data-postid="<%=post.post_id%>"><%=post.like_count%></span></span>
                                    </div>

                                    <% if (user) { %>
                                        <div class="post-card-actions">
                                            <button class="likebutton action-btn" id="likebutton" data-postid="<%=post.post_id%>">
                                                <i class="fas fa-heart"></i> Like
                                            </button>
                                            <form action="/comment/<%=post.post_id%>" method="post" class="comment-form">
                                                <input type="text" id="content" name="content" placeholder="Write a comment..." class="comment-input">
                                                <button type="submit" class="comment-submit">Post</button>
                                            </form>
                                        </div>
                                    <% } %>
                                    
                                    <button class="commentbutton action-btn" data-postid="<%=post.post_id%>">
                                        <i class="fas fa-comment"></i> View Comments
                                    </button>
                                    <div class="commentsection"></div>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p class="no-posts" style="grid-column: 1 / -1; text-align: center; padding: 40px; color: #666;">
                            No posts in your favorite genre yet. Be the first to share something!
                        </p>
                    <% } %>
                </div>
            </div>
        <% } %>

        <div class="feed-section">
            <div class="section-header">
                <h2 class="section-title">Recent Posts</h2>
                <span class="section-sub">Latest from the community</span>
            </div>

            <div class="posts-grid">
                <% if (Array.isArray(popularPosts) && popularPosts.length > 0) { %>
                    <% for (var i = 0; i < popularPosts.length; i++) { %>
                        <div class="post-card">
                            <div class="post-card-image">
                                <% if (popularPosts[i].image_path) { %>
                                    <img src="assets/uploads/<%=popularPosts[i].image_path%>" alt="<%=popularPosts[i].post_title%>">
                                <% } else { %>
                                    <div class="post-card-image--placeholder">
                                        <i class="fas fa-gamepad"></i>
                                    </div>
                                <% } %>
                            </div>

                            <div class="post-card-info">
                                <span class="post-card-game"><%=popularPosts[i].game_name%></span>
                                <h3 class="post-card-title"><%=popularPosts[i].post_title%></h3>
                                <p class="post-card-body"><%=popularPosts[i].post_body%></p>

                                <div class="post-card-meta">
                                    <a href="/user/<%=popularPosts[i].user_id%>" class="post-card-user">
                                        <i class="fas fa-circle-user"></i>
                                        <%=popularPosts[i].username%>
                                    </a>
                                    <span class="post-card-likes">
                                        <i class="fas fa-heart"></i>
                                        <span class="postlikes" data-postid="<%=popularPosts[i].post_id%>"><%=popularPosts[i].like_count%></span>
                                    </span>
                                </div>

                                <% if (user) { %>
                                    <div class="post-card-actions">
                                        <button class="likebutton action-btn" id="likebutton" data-postid="<%=popularPosts[i].post_id%>">
                                            <i class="fas fa-heart"></i> Like
                                        </button>
                                        <form action="/comment/<%=popularPosts[i].post_id%>" method="post" class="comment-form">
                                            <input type="text" id="content" name="content" placeholder="Write a comment..." class="comment-input">
                                            <button type="submit" class="comment-submit">Post</button>
                                        </form>
                                    </div>
                                <% } %>

                                <button class="commentbutton action-btn" id="commentbutton" data-postid="<%=popularPosts[i].post_id%>">
                                    <i class="fas fa-comment"></i> View Comments
                                </button>
                                <div class="commentsection"></div>
                            </div>
                        </div>
                    <% } %>
                <% } else { %>
                    <p class="no-posts">No posts yet. Be the first to post!</p>
                <% } %>
            </div>
        </div>

    </main>
</div>

<script src="/viewcomments.js"></script>
<script src="/likebutton.js"></script>
<%- include("../partials/footer.ejs") %>