<nav class="navbarhead">
    <div class="nav-left">
        <strong class="logotitle">GameHub</strong>
        <a href="/" class="logolink">Home</a>
        <a href="/games" class="logolink">List of Games</a>
    </div>

    <div class="nav-right">
        <% if (user) { %>
            <a href="/post" class="createpost">+ Create Post</a>
            
            <span>Welcome, <strong><%= user.username %></strong></span>
            
            <form action="/logout" method="POST" class="logoutcontainer">
                <button type="submit" class="logoutbutton">Logout</button>
            </form>
        <% } else { %>
            <a href="/login" class="loginbutton">Login</a>
            <a href="/register" class="registerbutton">Sign Up</a>
        <% } %>
    </div>
</nav>